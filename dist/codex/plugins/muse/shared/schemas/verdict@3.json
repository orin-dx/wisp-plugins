{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verdict@3",
  "title": "Verdict",
  "description": "A scoped gate decision with blockers, non-blocking gaps, pending checks, and optional provenance.",
  "type": "object",
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "pass"}}, "required": ["verdict"]},
      "then": {
        "properties": {
          "blockers": {"maxItems": 0},
          "pending_checks": {"maxItems": 0},
          "coverage_gaps": {"items": {"properties": {"blocking": {"const": false}}, "required": ["blocking"]}}
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "fail"}}, "required": ["verdict"]},
      "then": {"properties": {"blockers": {"minItems": 1}}, "required": ["blockers"]}
    }
  ],
  "required": ["verdict", "confidence", "verified_scope", "coverage_gaps", "pending_checks", "verdict_summary"],
  "additionalProperties": false,
  "properties": {
    "verdict": {"enum": ["pass", "fail"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "verified_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "finding"],
        "additionalProperties": false,
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "finding", "blocking"],
        "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"},
          "location": {"type": "string", "minLength": 1}
        }
      }
    },
    "pending_checks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "flagged_for_review": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "finding"],
        "additionalProperties": false,
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1}
        }
      }
    },
    "workspace_state": {
      "type": "object",
      "required": ["revision", "dirty"],
      "additionalProperties": false,
      "properties": {
        "revision": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"}
      }
    },
    "workflow_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plugin", "version"],
        "additionalProperties": false,
        "properties": {
          "plugin": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source_revision": {"type": "string", "minLength": 1}
        }
      }
    },
    "verdict_summary": {"type": "string", "maxLength": 300},
    "artifact_type": {"type": "string", "minLength": 1},
    "retry_count": {"type": "integer", "minimum": 0},
    "reasoning": {"type": "string", "description": "Private producer scratchpad; not forwarded downstream."}
  }
}
